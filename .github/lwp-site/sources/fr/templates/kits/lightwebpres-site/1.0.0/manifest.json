{
  "schema": "lightwebpres.identity-kit/1",
  "id": "lightwebpres-site",
  "version": "1.0.0",
  "label": "LightWebPres · le site",
  "default_preset": "web",
  "layouts": {
    "cover": {
      "default": "slides/cover.html"
    },
    "standard": {
      "default": "slides/standard.html"
    },
    "series-nav": {
      "default": "slides/series-nav.html"
    },
    "full-article": {
      "default": "slides/full-article.html"
    },
    "index": "index.html"
  },
  "structure_css": "structure.css",
  "themes": {
    "encre": "themes/encre.conf",
    "papier": "themes/papier.conf"
  },
  "presets": {
    "web": {
      "label": "Le site",
      "description": "Le site public de LightWebPres : encre, citron et contenu avant tout.",
      "theme": "encre",
      "slide_layouts": {
        "cover": "default",
        "standard": "default",
        "series-nav": "default",
        "full-article": "default"
      },
      "slide_chrome": {}
    }
  }
}
